                    { user: '리뷰어 C', text: '급식으로 나오면 항상 잔반 없이 싹 비우는 메뉴 1위.' }
                ],
                summary: '인기 지수가 매우 높은 메뉴로 학생 선호도가 탁월합니다. 바삭한 식감과 단백질이 풍부하지만 칼로리가 다소 높을 수 있으므로 샐러드와의 조합이 권장됩니다.'
            },
            '제육': {
                img: 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=600&q=80',
                cals: 550,
                score: 9.2,
                comment: '매콤달콤한 한국인의 밥도둑 급식!',
                carbs: 25, protein: 35, fat: 22,
                reviews: [
                    { user: '급식매니아', text: '제육 볶음 나오는 날은 밥 두 공기 기본입니다.' },
                    { user: '영양사 C', text: '비타민 B1이 풍부한 돼지고기와 채소의 균형이 양호합니다.' },
                    { user: '학생 D', text: '양념이 잘 배어있어 실패 없는 시그니처 메뉴입니다.' }
                ],
                summary: '매콤달콤한 포뮬러로 식욕을 증진시키며 필수 아미노산 함량이 높습니다. 쌈채소나 나물류와 함께 섭취 시 완벽한 탄단지 균형을 이룹니다.'
            },
            '마라탕': {
                img: 'https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=600&q=80',
                cals: 720,
                score: 8.5,
                comment: '요즘 학생들의 압도적 1위 최애 메뉴!',
                carbs: 60, protein: 25, fat: 32,
                reviews: [
                    { user: '트렌드세터', text: '급식에 마라탕이 나온다니 학교 다닐 맛 나네요!' },
                    { user: '식품연구원', text: '향신료의 알싸함이 스트레스 해소에 도움을 줍니다.' },
                    { user: '학생 F', text: '국물까지 다 마시게 되는 자극적이고 당기는 맛.' }
                ],
                summary: '젊은 층의 호응도가 폭발적인 메뉴입니다. 나트륨과 지방 함량이 다소 높아 자주는 어렵지만 기분 전환용 급식으로 최상의 만족도를 선사합니다.'
            },
            'default': {
                img: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80',
                cals: 580,
                score: 8.9,
                comment: '알찬 구성과 건강한 영양 밸런스!',
                carbs: 50, protein: 28, fat: 18,
                reviews: [
                    { user: '미식가', text: '전반적인 간이 적당하고 부담 없이 즐기기 좋습니다.' },
                    { user: '영양사 Kim', text: '탄수화물, 단백질, 지방 비율이 안정적으로 설계된 식단입니다.' },
                    { user: '학생 E', text: '호불호 없이 호평을 받는 무난하고 맛있는 구성!' }
                ],
                summary: '다양한 식재료가 어우러져 건강과 맛을 모두 잡은 메뉴입니다. Web 빅데이터 분석 결과, 유저 종합 긍정 평가율이 89%에 달합니다.'
            }
        };

        function analyzeMenu() {
            const inputVal = document.getElementById('menuInput').value.trim();
            if (!inputVal) {
                alert('급식 메뉴를 입력해주세요!');
                return;
            }

            goToScreen('loading');

            // Loading message updates
            const subtext = document.getElementById('loadingProgress');
            setTimeout(() => { subtext.innerText = "웹 사이트 & 블로그 포스팅 1,200건 탐색 중..."; }, 700);
            setTimeout(() => { subtext.innerText = "영양 성분 분석표 및 칼로리 계산 완료..."; }, 1400);
            setTimeout(() => { subtext.innerText = "AI 신뢰도 점수 및 종합 리뷰 생성 중..."; }, 2100);

            setTimeout(() => {
                renderResult(inputVal);
                goToScreen('result');
            }, 2600);
        }

        function renderResult(menuName) {
            document.getElementById('resultMenuTitle').innerText = `"${menuName}" 분석 결과`;

            // Select data pattern
            let data = foodDatabase['default'];
            if (menuName.includes('돈까스') || menuName.includes('돈가스')) data = foodDatabase['돈까스'];
            else if (menuName.includes('제육') || menuName.includes('고기')) data = foodDatabase['제육'];
            else if (menuName.includes('마라') || menuName.includes('면')) data = foodDatabase['마라탕'];

            // Fill UI
            document.getElementById('foodImage').src = data.img;
            document.getElementById('calorieText').innerText = `${data.cals} kcal`;
            document.getElementById('scoreNumber').innerText = data.score.toFixed(1);
            document.getElementById('scoreComment').innerText = data.comment;
            document.getElementById('aiSummaryText').innerText = data.summary;

            // Render Nutrition Bars
            const nutiContainer = document.getElementById('nutritionList');
            nutiContainer.innerHTML = `
                <div class="nutrition-item">
                    <span style="width:50px;">탄수화물</span>
                    <div class="bar-bg"><div class="bar-fill" style="width: ${data.carbs * 1.5}%; background:#4ECDC4;"></div></div>
                    <span style="font-weight:600;">${data.carbs}g</span>
                </div>
                <div class="nutrition-item">
                    <span style="width:50px;">단백질</span>
                    <div class="bar-bg"><div class="bar-fill" style="width: ${data.protein * 2}%; background:#FF6B6B;"></div></div>
                    <span style="font-weight:600;">${data.protein}g</span>
                </div>
                <div class="nutrition-item">
                    <span style="width:50px;">지방</span>
                    <div class="bar-bg"><div class="bar-fill" style="width: ${data.fat * 2}%; background:#FFE66D;"></div></div>
                    <span style="font-weight:600;">${data.fat}g</span>
                </div>
            `;

            // Render Reviews
            const reviewContainer = document.getElementById('reviewList');
            reviewContainer.innerHTML = data.reviews.map(r => `
                <div class="review-item">
                    <span class="review-text">"${r.text}"</span>
                    <span class="review-user">- ${r.user}</span>
                </div>
            `).join('');
        }

        function resetApp() {
            document.getElementById('menuInput').value = '';
            goToScreen('landing');
        }
    </script>
</body>
</html>
