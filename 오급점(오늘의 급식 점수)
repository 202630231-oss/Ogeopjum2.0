<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오급점 - 오늘의 급식 점수</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;600;700;800;900&family=Gmarket+Sans:wght@500;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #FF6B6B;
            --primary-hover: #FF5252;
            --secondary: #4ECDC4;
            --accent: #FFE66D;
            --bg-gradient: linear-gradient(135deg, #FFF5F5 0%, #E8F7F5 100%);
            --card-bg: rgba(255, 255, 255, 0.9);
            --text-main: #2D3748;
            --text-sub: #718096;
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.03);
            --radius-lg: 24px;
            --radius-md: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
        }

        body {
            background: var(--bg-gradient);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        /* Container Layout */
        .app-container {
            width: 100%;
            max-width: 900px;
            min-height: 650px;
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            border-radius: var(--radius-lg);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: var(--shadow-lg);
            padding: 40px;
            position: relative;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Background Animated Circles */
        .circle-bg {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            z-index: 0;
            opacity: 0.6;
        }
        .circle-1 {
            width: 250px;
            height: 250px;
            background: #FFB8B8;
            top: -50px;
            left: -50px;
        }
        .circle-2 {
            width: 300px;
            height: 300px;
            background: #A8E6CF;
            bottom: -80px;
            right: -80px;
        }

        .screen {
            position: relative;
            z-index: 10;
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        .screen.active {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 1;
            transform: translateY(0);
        }

        /* SCREEN 1: LANDING */
        #screen-landing {
            justify-content: center;
            text-align: center;
            min-height: 550px;
        }

        .main-logo-icon {
            font-size: 64px;
            color: var(--primary);
            margin-bottom: 20px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .title-badge {
            display: inline-block;
            background: rgba(255, 107, 107, 0.1);
            color: var(--primary);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 12px;
            letter-spacing: 1px;
        }

        .main-title {
            font-family: 'Gmarket Sans', sans-serif;
            font-size: 48px;
            font-weight: 700;
            color: #1A202C;
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .main-title span {
            color: var(--primary);
        }

        .sub-title {
            font-size: 18px;
            color: var(--text-sub);
            margin-bottom: 40px;
            font-weight: 400;
        }

        .btn-enter {
            background: var(--primary);
            color: white;
            font-size: 20px;
            font-weight: 700;
            padding: 16px 48px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 20px rgba(255, 107, 107, 0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-enter:hover {
            background: var(--primary-hover);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 15px 25px rgba(255, 107, 107, 0.4);
        }

        /* SCREEN 2: INPUT */
        #screen-input {
            width: 100%;
            justify-content: center;
            min-height: 550px;
        }

        .input-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .input-header h2 {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .input-header p {
            color: var(--text-sub);
            font-size: 15px;
        }

        .input-box-wrapper {
            width: 100%;
            max-width: 600px;
            position: relative;
        }

        .menu-input {
            width: 100%;
            padding: 22px 24px;
            padding-right: 70px;
            font-size: 18px;
            border: 2px solid #E2E8F0;
            border-radius: var(--radius-md);
            outline: none;
            background: white;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
        }

        .menu-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(255, 107, 107, 0.15);
        }

        .btn-submit-input {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 48px;
            height: 48px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: all 0.2s ease;
        }

        .btn-submit-input:hover {
            background: var(--primary-hover);
            transform: translateY(-50%) scale(1.05);
        }

        .input-hint {
            margin-top: 16px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .hint-tag {
            background: #EDF2F7;
            color: #4A5568;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .hint-tag:hover {
            background: #E2E8F0;
            color: var(--primary);
        }

        /* SCREEN 3: LOADING */
        #screen-loading {
            min-height: 550px;
            justify-content: center;
            text-align: center;
        }

        .ai-loader {
            position: relative;
            width: 100px;
            height: 100px;
            margin-bottom: 24px;
        }

        .spinner {
            width: 100%;
            height: 100%;
            border: 4px solid #E2E8F0;
            border-top: 4px solid var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        .ai-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 32px;
            color: var(--primary);
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loading-text {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .loading-subtext {
            font-size: 14px;
            color: var(--text-sub);
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        /* SCREEN 4: RESULT */
        #screen-result {
            width: 100%;
        }

        .result-header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #EDF2F7;
        }

        .result-title-group h2 {
            font-size: 24px;
            font-weight: 800;
        }

        .result-title-group p {
            font-size: 14px;
            color: var(--text-sub);
        }

        .btn-refresh {
            background: #EDF2F7;
            color: var(--text-main);
            border: none;
            padding: 10px 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-refresh:hover {
            background: #E2E8F0;
            color: var(--primary);
            transform: rotate(180deg);
        }

        /* Result Layout Grid */
        .result-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            width: 100%;
            margin-bottom: 24px;
        }

        @media (max-width: 768px) {
            .result-grid {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: white;
            border-radius: var(--radius-md);
            padding: 20px;
            box-shadow: var(--shadow-sm);
            border: 1px solid #EDF2F7;
        }

        .food-image-container {
            position: relative;
            width: 100%;
            height: 220px;
            border-radius: var(--radius-md);
            overflow: hidden;
            margin-bottom: 16px;
        }

        .food-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .food-tag {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .score-card {
            background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .score-title {
            font-size: 16px;
            font-weight: 600;
            opacity: 0.9;
            margin-bottom: 8px;
        }

        .score-number-box {
            display: flex;
            align-items: baseline;
            gap: 4px;
            margin-bottom: 8px;
        }

        .score-number {
            font-size: 64px;
            font-weight: 900;
            line-height: 1;
            font-family: 'Gmarket Sans', sans-serif;
        }

        .score-max {
            font-size: 20px;
            opacity: 0.8;
        }

        .score-comment {
            font-size: 14px;
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            margin-top: 8px;
        }

        /* Nutrition List */
        .nutrition-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .nutrition-header h3 {
            font-size: 16px;
            font-weight: 700;
        }

        .calorie-badge {
            background: #FFF5F5;
            color: var(--primary);
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 13px;
        }

        .nutrition-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .nutrition-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
        }

        .bar-bg {
            flex-grow: 1;
            height: 8px;
            background: #EDF2F7;
            border-radius: 4px;
            margin: 0 12px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: var(--secondary);
            border-radius: 4px;
        }

        /* Reviews Section */
        .reviews-section {
            width: 100%;
        }

        .reviews-section h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .reviews-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .review-item {
            background: #F7FAFC;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 3px solid var(--secondary);
        }

        .review-text {
            color: #4A5568;
        }

        .review-user {
            font-size: 12px;
            color: #A0AEC0;
            font-weight: 600;
        }

        /* AI Analysis Box */
        .ai-analysis-box {
            width: 100%;
            background: #F0FDF4;
            border: 1px solid #BBF7D0;
            padding: 16px;
            border-radius: var(--radius-md);
            margin-top: 16px;
            font-size: 14px;
            color: #166534;
            line-height: 1.5;
        }

        .ai-analysis-box strong {
            display: block;
            margin-bottom: 4px;
            color: #15803D;
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Background Elements -->
        <div class="circle-bg circle-1"></div>
        <div class="circle-bg circle-2"></div>

        <!-- 1. LANDING SCREEN -->
        <div id="screen-landing" class="screen active">
            <div class="main-logo-icon">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <span class="title-badge">AI 기반 급식 평가 서비스</span>
            <h1 class="main-title">오급점<span>.</span></h1>
            <p class="sub-title">(오늘의 급식 점수)</p>
            <button class="btn-enter" onclick="goToScreen('input')">
                시작하기 <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <!-- 2. INPUT SCREEN -->
        <div id="screen-input" class="screen">
            <div class="input-header">
                <h2>오늘 나오는 급식은 무엇인가요?</h2>
                <p>메뉴를 입력해주시면 AI가 모든 인터넷을 검색하여 분석해드립니다.</p>
            </div>
            <div class="input-box-wrapper">
                <input type="text" id="menuInput" class="menu-input" placeholder="예: 돈까스, 김치찌개, 떡볶이, 체리" onkeypress="handleKeyPress(event)">
                <button class="btn-submit-input" onclick="analyzeMenu()">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
            <div class="input-hint">
                <span class="hint-tag" onclick="quickInput('제육볶음, 된장찌개, 계란말이')">💡 제육볶음 + 계란말이</span>
                <span class="hint-tag" onclick="quickInput('치즈돈까스, 우동, 샐러드')">💡 치즈돈까스 + 우동</span>
                <span class="hint-tag" onclick="quickInput('마라탕, 꿔바로우, 계란볶음밥')">💡 마라탕 + 꿔바로우</span>
            </div>
        </div>

        <!-- 3. LOADING SCREEN -->
        <div id="screen-loading" class="screen">
            <div class="ai-loader">
                <div class="spinner"></div>
                <i class="fa-solid fa-brain ai-icon"></i>
            </div>
            <div class="loading-text">AI가 웹 전체 사이트를 탐색 중입니다...</div>
            <div class="loading-subtext" id="loadingProgress">영양소 데이터베이스 및 실시간 리뷰 수집 중</div>
        </div>

        <!-- 4. RESULT SCREEN -->
        <div id="screen-result" class="screen">
            <div class="result-header">
                <div class="result-title-group">
                    <h2 id="resultMenuTitle">메뉴 분석 결과</h2>
                    <p>AI가 객관적인 빅데이터를 기반으로 산출한 결과입니다.</p>
                </div>
                <button class="btn-refresh" onclick="resetApp()" title="처음으로 돌아가기">
                    <i class="fa-solid fa-rotate-right"></i> 다시하기
                </button>
            </div>

            <div class="result-grid">
                <!-- Food Image & Info Card -->
                <div class="card">
                    <div class="food-image-container">
                        <img id="foodImage" src="" alt="음식 사진">
                        <span class="food-tag"><i class="fa-solid fa-camera"></i> 대표 이미지</span>
                    </div>
                    
                    <div class="nutrition-header">
                        <h3><i class="fa-solid fa-chart-pie" style="color:var(--secondary)"></i> 핵심 영양 정보</h3>
                        <span class="calorie-badge" id="calorieText">0 kcal</span>
                    </div>
                    <div class="nutrition-list" id="nutritionList">
                        <!-- Dynamic Injection -->
                    </div>
                </div>

                <!-- AI Score & Reviews Card -->
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <!-- Score Box -->
                    <div class="card score-card">
                        <div class="score-title">AI 판단 오늘의 급식 점수</div>
                        <div class="score-number-box">
                            <span class="score-number" id="scoreNumber">0.0</span>
                            <span class="score-max">/ 10</span>
                        </div>
                        <div class="score-comment" id="scoreComment">완벽에 가까운 영양 균형!</div>
                    </div>

                    <!-- Reviews Box -->
                    <div class="card reviews-section">
                        <h3><i class="fa-solid fa-comments" style="color:#F6AD55"></i> 사람들 평가 & 리뷰</h3>
                        <div class="reviews-list" id="reviewList">
                            <!-- Dynamic Injection -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI Comprehensive Evaluation -->
            <div class="ai-analysis-box">
                <strong><i class="fa-solid fa-robot"></i> AI 총평</strong>
                <span id="aiSummaryText">분석 중...</span>
            </div>
        </div>
    </div>

    <script>
        // Screen Navigation
        function goToScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            setTimeout(() => {
                document.getElementById('screen-' + screenId).classList.add('active');
            }, 50);
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') {
                analyzeMenu();
            }
        }

        function quickInput(text) {
            document.getElementById('menuInput').value = text;
            analyzeMenu();
        }

        // Mock Database & AI Intelligence Simulation
        const foodDatabase = {
            '돈까스': {
                img: 'https://images.unsplash.com/photo-1591814468924-caf88d1232e1?auto=format&fit=crop&w=600&q=80',
